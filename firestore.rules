rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /users/{userId} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == userId;
    }

    match /spaces/{spaceId} {
      // 누구나 등록 공간을 탐색할 수 있지만 수정은 소유자만 할 수 있습니다.
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /requests/{requestId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.seekerId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.seekerId == request.auth.uid;
    }

    match /matches/{matchId} {
      function isOwner() { return signedIn() && resource.data.ownerId == request.auth.uid; }
      function isSeeker() { return signedIn() && resource.data.seekerId == request.auth.uid; }
      function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
      function identityKept() {
        return request.resource.data.spaceId == resource.data.spaceId
          && request.resource.data.requestId == resource.data.requestId
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.seekerId == resource.data.seekerId;
      }

      allow read: if isOwner() || isSeeker();

      // 소유자는 본인 공간을, 이용자는 실제 등록된 요청을 대상으로만 연결을 시작합니다.
      allow create: if signedIn()
        && request.resource.data.initiator == 'owner'
        && request.resource.data.status == 'proposed'
        && request.resource.data.ownerId == request.auth.uid
        && get(/databases/$(database)/documents/spaces/$(request.resource.data.spaceId)).data.ownerId == request.auth.uid
        && get(/databases/$(database)/documents/requests/$(request.resource.data.requestId)).data.seekerId == request.resource.data.seekerId
        && request.resource.data.score is number
        && request.resource.data.score >= 0 && request.resource.data.score <= 100;

      allow create: if signedIn()
        && request.resource.data.initiator == 'seeker'
        && request.resource.data.status == 'applied'
        && request.resource.data.seekerId == request.auth.uid
        && get(/databases/$(database)/documents/requests/$(request.resource.data.requestId)).data.seekerId == request.auth.uid
        && get(/databases/$(database)/documents/spaces/$(request.resource.data.spaceId)).data.ownerId == request.resource.data.ownerId
        && request.resource.data.score is number
        && request.resource.data.score >= 0 && request.resource.data.score <= 100;

      // 제안을 받은 이용자와 신청을 받은 소유자만 상태를 결정할 수 있습니다.
      allow update: if isSeeker()
        && identityKept()
        && changed().hasOnly(['status'])
        && resource.data.status == 'proposed'
        && request.resource.data.status in ['accepted', 'rejected'];

      allow update: if isOwner()
        && identityKept()
        && changed().hasOnly(['status'])
        && resource.data.status == 'applied'
        && request.resource.data.status in ['accepted', 'rejected'];

      // 소유자가 제안 가격과 설명을 다시 확인하는 기존 흐름을 유지합니다.
      allow update: if isOwner()
        && identityKept()
        && resource.data.status in ['candidate', 'proposed']
        && request.resource.data.status == 'proposed'
        && changed().hasOnly(['status', 'score', 'reason', 'approvedPrice', 'initiator', 'algorithmVersion', 'createdAt'])
        && request.resource.data.score is number
        && request.resource.data.score >= 0 && request.resource.data.score <= 100;

      // 성사된 매칭의 두 참여자만 실시간 대화를 읽고 보낼 수 있습니다.
      match /messages/{messageId} {
        function parentMatch() { return get(/databases/$(database)/documents/matches/$(matchId)); }
        function participant() {
          return signedIn()
            && parentMatch().data.status == 'accepted'
            && (parentMatch().data.ownerId == request.auth.uid || parentMatch().data.seekerId == request.auth.uid);
        }
        allow read: if participant();
        allow create: if participant()
          && request.resource.data.matchId == matchId
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;
        allow update, delete: if false;
      }

      allow delete: if false;
    }
  }
}
