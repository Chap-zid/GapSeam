# Firebase Console > Project settings > Your apps > Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_DEMO_MODE=false

# 서버 전용입니다. NEXT_PUBLIC_ 접두사를 붙이지 마세요.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
VWORD_API_KEY=
VWORD_DOMAIN=localhost

# 공공데이터포털(data.go.kr) 서비스 키. 실거래가·상권 근거 조회에 씁니다. 서버 전용입니다.
# 활용신청이 필요한 API: 국토교통부 단독/다가구 전월세·매매, 연립다세대 전월세·매매, 상업업무용 부동산 매매 실거래가,
# 소상공인시장진흥공단 상가(상권)정보. 인코딩 키와 디코딩 키 어느 쪽을 넣어도 됩니다.
DATA_GO_KR_SERVICE_KEY=

# Docker ONLYOFFICE 문서 편집기
ONLYOFFICE_JWT_SECRET=
NEXT_PUBLIC_ONLYOFFICE_URL=http://localhost:8080
DOCUMENT_SERVER_CALLBACK_ORIGIN=http://host.docker.internal:3000
