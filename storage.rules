rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /spaces/{spaceId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }

    match /ownership-proofs/{userId}/{spaceId}/{fileName} {
      function isAdmin() { return request.auth != null && request.auth.token.admin == true; }
      function ownsSpace() {
        return firestore.exists(/databases/(default)/documents/spaces/$(spaceId))
          && firestore.get(/databases/(default)/documents/spaces/$(spaceId)).data.ownerId == request.auth.uid;
      }
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId && ownsSpace());
      allow create: if request.auth != null
        && request.auth.uid == userId
        && ownsSpace()
        && request.resource.size <= 15 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/(jpeg|png|webp)');
      allow update, delete: if false;
    }
  }
}
